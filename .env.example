# Copy to .env (never commit .env). All values are optional unless using that integration.

# --- Narrow LLM Extractor (OpenAI-compatible) ---
# Defaults to local Ollama (zero external egress) when unset.
ZEROBOM_LLM_BASE_URL=http://localhost:11434/v1
ZEROBOM_LLM_MODEL=llama3.2
ZEROBOM_LLM_API_KEY=

# --- Alerting & Triage Worker ---
ZEROBOM_WEBHOOK_URL=
ZEROBOM_WEBHOOK_SECRET=
ZEROBOM_SLACK_WEBHOOK_URL=
ZEROBOM_SLACK_SIGNING_SECRET=
# Optional Socket Mode (requires zerobom[slack]):
ZEROBOM_SLACK_APP_TOKEN=
ZEROBOM_SLACK_BOT_TOKEN=

# --- GitHub Issue Sync ---
ZEROBOM_GITHUB_TOKEN=
# ZEROBOM_GITHUB_API_URL=https://api.github.com

# --- Built-in Enterprise Backends ---
ZEROBOM_DT_API_KEY=
